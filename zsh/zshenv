#!/usr/bin/env zsh
#
# zshenv — sourced for EVERY zsh invocation (interactive, scripts, GUI apps
# launched via `open`). Keep this file minimal: only environment variables
# that something outside an interactive shell might need.
#

# --- XDG Base Directory spec --------------------------------------------------
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"

# --- Dotfiles locations --------------------------------------------------------
export DOTFILES="$HOME/.dotfiles"
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"

# --- Tool-specific config paths ------------------------------------------------
export LOCATE_CONFIG="/etc/locate.users.rc"                 # `locate` command's database
export BAT_CONFIG_PATH="$XDG_CONFIG_HOME/bat/bat.conf"

# --- Per-machine / per-language overrides --------------------------------------
[ -f "$HOME/.config/env/env.sh" ] && . "$HOME/.config/env/env.sh"
