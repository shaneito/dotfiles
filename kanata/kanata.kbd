(defcfg
  process-unmapped-keys yes
  log-layer-changes no
  danger-enable-cmd yes
  concurrent-tap-hold yes
  macos-dev-names-include (
    "Apple Internal Keyboard / Trackpad"
    "Keychron K3"
    "Karabiner DriverKit VirtualHIDKeyboard 1.8.0"
  )
)

(defvar
 tap-time 300
 hold-time 300
 chord-time 60
)

(defsrc
  esc    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv    1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab    q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps   a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft   z    x    c    v    b    n    m    ,    .    /    ▲    rsft
  fn   lctl  lalt lmet          spc         rmet ralt ◀    ▼    ▶
)

(deflayer default

  _      f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  _      _    _    _    _    _    _    _    _    _    _    _    _    _
  _      _    _    _    _    _    _    _    _    _    _    _    _    _
  @cap   _    _    _    _    _    _    _    _    _    _    _    _
  _      _    _    _    _    _    _    _    _    _    _    _    _
  @fnl   _    _    _            @spc        _    _    _    _    _
)

(deflayer arrows
  _      _    _    _    _    _    _    _    _    _    _    _    _
  _      _    _    _    _    _    _    _    _    _    _    _    _    _
  _      _    _    _    _    _    _    _    _    _    _    _    _    _
  _      _    _    _    _    _    left down up   rght _    _    _
  _      _    _    _    _    _    _    _    _    _    _    _    _
  _      _    _    _              _         _    _    _    _    _
)

(deflayer fn-keys
  _      🔅   🔆    @mc  @sls @dtn @dnd ◀◀   ▶⏸   ▶▶   🔇   🔉    🔊
  _      _    _    _    _    _    _    _    _    _    _    _    _    _
  _      _    _    _    _    _    _    _    _    _    _    _    _    _
  _      _    _    _    _    _    _    _    _    _    _    _    _
  _      _    _    _    _    _    _    _    _    _    _    _    _
  _      _    _    _              _         _    _    _    _    _
)

(defalias
  cap (tap-hold-press 200 200 esc lctl)
  spc (tap-hold-press 200 200 spc (layer-toggle arrows))
  fnl (layer-while-held fn-keys)
  mc S-C-up ;; Mission Control
  sls A-M-spc ;; Spotlight Search
  dtn S-C-A-M-f5 ;; Dictation
  dnd S-C-A-M-f6 ;; Do Not Disturb
)
